{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#E9EADE"
    },
    "surface": {
      "$type": "color",
      "$value": "#FBFBF5"
    },
    "surface-sunk": {
      "$type": "color",
      "$value": "#F2F3EA"
    },
    "ink": {
      "$type": "color",
      "$value": "#14150F"
    },
    "ink-muted": {
      "$type": "color",
      "$value": "#5C5E52"
    },
    "line": {
      "$type": "color",
      "$value": "#D4D6C8"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#B9BBAF"
    },
    "danger": {
      "$type": "color",
      "$value": "#8C3A3A"
    },
    "accent-mint": {
      "$type": "color",
      "$value": "#AFD1C6",
      "$description": "saved / matched"
    },
    "accent-iris": {
      "$type": "color",
      "$value": "#D0C1EA",
      "$description": "in progress"
    },
    "accent-orchid": {
      "$type": "color",
      "$value": "#E8BAE8",
      "$description": "new / urgent"
    },
    "accent-sage": {
      "$type": "color",
      "$value": "#CACCC4",
      "$description": "closed / disabled"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "hit-min": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "saansFont",
        "saansFont Fallback",
        "Schibsted Grotesk",
        "Helvetica",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "Menlo",
        "monospace"
      ]
    }
  },
  "text": {
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "22px",
        "lineHeight": "1.2",
        "fontWeight": 600,
        "letterSpacing": "-0.015em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "16px",
        "lineHeight": "1.5",
        "fontWeight": 400,
        "letterSpacing": "0"
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontSize": "14px",
        "lineHeight": "1.45",
        "fontWeight": 400,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontSize": "12px",
        "lineHeight": "1.3",
        "fontWeight": 500,
        "letterSpacing": "0.06em",
        "textTransform": "uppercase"
      }
    }
  },
  "motion": {
    "dur-state": {
      "$type": "duration",
      "$value": "120ms"
    },
    "dur-sheet": {
      "$type": "duration",
      "$value": "240ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
}