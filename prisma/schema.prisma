// Hirelane job board — data model.
// Covers all three pipeline stages (sourcing, improving, posting); Phase 1 UI reads only
// Job rows with status = PUBLISHED. See docs/todo/01-data-model.md and 06-phase-2-handoff.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Stage 1: Sourcing
// ---------------------------------------------------------------------------

model Source {
  id             String    @id @default(cuid())
  name           String
  baseUrl        String
  /// Crawl strategy + CSS/XPath selector config, owned entirely by phase 2.
  crawlConfig    Json
  cadenceMinutes Int       @default(360)
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rawJobs    RawJob[]
  ingestRuns IngestRun[]

  @@index([enabled])
}

enum FetchStatus {
  PENDING
  /// Claimed by an in-flight acquisition attempt; stale claims (updatedAt past the claim window)
  /// are reclaimed by the next tick rather than blocking forever on a killed invocation.
  FETCHING
  FETCHED
  FAILED
}

model RawJob {
  id           String      @id @default(cuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String
  externalUrl  String
  rawTitle     String?
  rawCompany   String?
  rawLocation  String?
  /// Full untouched payload as scraped, shape owned by phase 2.
  payload      Json
  /// Hash of the payload, used to detect unchanged re-crawls.
  contentHash  String
  fetchStatus  FetchStatus @default(PENDING)
  /// Resolved canonical URL (<link rel="canonical"> or redirect target) — may differ from externalUrl.
  canonicalUrl String?
  /// HTTP status of the last acquisition attempt.
  httpStatus   Int?
  /// Set every discovery pass where this externalId is still present in the source's listing.
  lastSeenAt   DateTime?
  /// Set every time the detail page itself was actually re-fetched (distinct from lastSeenAt).
  lastCrawledAt DateTime?
  /// Set when the reconciled content actually changed vs. the previous contentHash.
  lastChangedAt DateTime?
  /// Increments each discovery pass this externalId is absent; resets to 0 when seen again.
  consecutiveMissingRuns Int @default(0)
  /// Flips false once consecutiveMissingRuns crosses ingest.missingRunsThreshold.
  active        Boolean   @default(true)
  /// True until a normalized Job has been produced (or aggregation is given up on after validation
  /// failure) — needed because "job IS NULL" can't distinguish "never attempted" from "permanently
  /// invalid" from "transient AI failure, please retry."
  needsAggregation Boolean @default(true)
  /// Claim marker so overlapping cron ticks don't double-pay for the same AI call.
  aggregationClaimedAt DateTime?
  /// Stamped with the extractor/selector logic version that produced this row's payload — lets a
  /// future rewrite force-reprocess old rows by bumping the version.
  extractionVersion String?
  discoveredAt DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ingestRunId  String?
  ingestRun    IngestRun?  @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)

  improvementRuns ImprovementRun[]
  ingestFailures  IngestFailure[]
  job             Job?

  // Idempotent ingestion: re-posting the same (source, externalId) upserts, never duplicates.
  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([fetchStatus])
  @@index([sourceId, active])
  @@index([fetchStatus, needsAggregation])
  @@index([ingestRunId])
}

enum IngestRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One row per source per discovery cycle. status=FAILED means discovery itself could not
/// complete (listing unreachable, robots.txt disallowed) — NOT "some items inside it failed."
/// Per-item failures are tracked via the counters below and IngestFailure rows; a run with
/// failedCount > 0 is still COMPLETED.
model IngestRun {
  id                    String          @id @default(cuid())
  sourceId              String
  source                Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status                IngestRunStatus @default(RUNNING)
  startedAt             DateTime        @default(now())
  finishedAt            DateTime?
  discoveredCount       Int             @default(0)
  newCount              Int             @default(0)
  changedCount          Int             @default(0)
  unchangedCount        Int             @default(0)
  missingCount          Int             @default(0)
  inactiveCount         Int             @default(0)
  failedCount           Int             @default(0)
  validationFailedCount Int             @default(0)
  aiFailedCount         Int             @default(0)

  rawJobs  RawJob[]
  failures IngestFailure[]

  @@index([sourceId, startedAt])
  @@index([status])
}

enum IngestFailureStage {
  DISCOVERY
  ACQUISITION
  EXTRACTION
  AGGREGATION
  VALIDATION
  PERSISTENCE
}

/// Human-readable per-URL error detail — nothing else in the schema captures more than a bare
/// enum status, and "failed extractions can be inspected" needs an actual message/detail payload.
model IngestFailure {
  id          String             @id @default(cuid())
  ingestRunId String
  ingestRun   IngestRun          @relation(fields: [ingestRunId], references: [id], onDelete: Cascade)
  rawJobId    String?
  rawJob      RawJob?            @relation(fields: [rawJobId], references: [id], onDelete: SetNull)
  stage       IngestFailureStage
  url         String?
  message     String
  detail      Json?
  createdAt   DateTime           @default(now())

  @@index([ingestRunId])
  @@index([rawJobId])
  @@index([stage])
}

// ---------------------------------------------------------------------------
// Stage 2: Improving
// ---------------------------------------------------------------------------

enum ImprovementStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ImprovementRun {
  id            String            @id @default(cuid())
  rawJobId      String
  rawJob        RawJob            @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?              @relation(fields: [jobId], references: [id])
  model         String
  promptVersion String
  inputTokens   Int?
  outputTokens  Int?
  /// Rewrite diff or before/after snapshot, shape owned by phase 2.
  diff          Json?
  status        ImprovementStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([rawJobId])
  @@index([jobId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3: Posting (Phase 1 — this is what the public UI reads)
// ---------------------------------------------------------------------------

enum JobStatus {
  DISCOVERED
  IMPROVING
  READY
  PUBLISHED
  CLOSED
  ARCHIVED
  REJECTED
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// What kind of opportunity a Job row represents. All share the Job shape (title, org, location,
/// deadline, apply link) — this is a tag, not a different schema. Extend by adding a case here AND
/// to `src/config/categories.ts` (single source of truth the nav/filters/ingest all read from).
enum OpportunityCategory {
  JOB
  INTERNSHIP
  LEARNERSHIP
  APPRENTICESHIP
  GRADUATE_PROGRAMME
  CALL_FOR_APPLICATIONS
  FUNDING
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([name])
}

model Job {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  category       OpportunityCategory @default(JOB)
  location       String
  remoteType     RemoteType
  employmentType EmploymentType
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?        @default("USD")
  salaryPeriod   SalaryPeriod?
  /// Rewritten, brand-voice, post-ready description (phase 2 output).
  description    String
  highlights     String[]       @default([])
  /// External apply URL — set unless isNative is true.
  applyUrl       String?
  isNative       Boolean        @default(false)
  status         JobStatus      @default(DISCOVERED)
  postedAt       DateTime?
  closesAt       DateTime?
  rawJobId       String?        @unique
  rawJob         RawJob?        @relation(fields: [rawJobId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tags            JobTag[]
  savedBy         SavedJob[]
  improvementRuns ImprovementRun[]

  // The list query's primary access pattern: published jobs newest first.
  @@index([status, postedAt])
  @@index([status, category, postedAt])
  @@index([companyId])
  @@index([location])
  // Upgraded to a pg_trgm GIN index on title/description in the initial migration
  // (see prisma/migrations/*/migration.sql) — plain btree here documents intent.
  @@index([title])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  jobs JobTag[]
}

model JobTag {
  jobId String
  tagId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Content — genuinely different shape from an opportunity: no deadline, no apply link.
// ---------------------------------------------------------------------------

/// Extend by adding a case here AND to `src/config/categories.ts`.
enum ContentCategory {
  HOW_TO
  CAREER_DEVELOPMENT
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  category    ContentCategory
  summary     String?
  body        String
  author      String?
  source      String?
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, publishedAt])
  @@index([published])
}

model Course {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  provider      String
  description   String
  /// Display string ("Free", "R1,200", "$49") — deliberately not a typed amount; providers quote
  /// price in wildly inconsistent shapes and this is display-only, never filtered/summed.
  priceLabel    String?
  durationLabel String?
  enrollUrl     String
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// User data (Clerk-keyed, no local User table)
// ---------------------------------------------------------------------------

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Serialized filter state: { q, location, remote, employmentType, salaryMin, tags, company, postedWithin }
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts JobAlert[]

  @@index([userId])
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

model JobAlert {
  id            String         @id @default(cuid())
  userId        String
  savedSearchId String?
  savedSearch   SavedSearch?   @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  frequency     AlertFrequency @default(DAILY)
  enabled       Boolean        @default(true)
  lastSentAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}
