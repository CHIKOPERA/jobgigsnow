// JobGigsNow job board — data model.
// Covers all three pipeline stages (sourcing, improving, posting); Phase 1 UI reads only
// Job rows with status = PUBLISHED. See docs/todo/01-data-model.md and 06-phase-2-handoff.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Stage 1: Sourcing
// ---------------------------------------------------------------------------

model Source {
  id             String    @id @default(cuid())
  name           String
  baseUrl        String
  /// Crawl strategy + CSS/XPath selector config, owned entirely by phase 2.
  crawlConfig    Json
  cadenceMinutes Int       @default(360)
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Learned priority used by the daily manager. Higher-scoring sources are checked first.
  agentPriority  Float     @default(0)
  agentReason    String?
  /// Learned distribution of opportunity types, industries and provinces this source supplies.
  agentProfile   Json?

  rawJobs    RawJob[]
  ingestRuns IngestRun[]

  @@index([enabled])
}

enum FetchStatus {
  PENDING
  /// Claimed by an in-flight acquisition attempt; stale claims (updatedAt past the claim window)
  /// are reclaimed by the next tick rather than blocking forever on a killed invocation.
  FETCHING
  FETCHED
  FAILED
}

model RawJob {
  id           String      @id @default(cuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String
  externalUrl  String
  rawTitle     String?
  rawCompany   String?
  rawLocation  String?
  /// Full untouched payload as scraped, shape owned by phase 2.
  payload      Json
  /// Hash of the payload, used to detect unchanged re-crawls.
  contentHash  String
  fetchStatus  FetchStatus @default(PENDING)
  /// Resolved canonical URL (<link rel="canonical"> or redirect target) — may differ from externalUrl.
  canonicalUrl String?
  /// HTTP status of the last acquisition attempt.
  httpStatus   Int?
  /// Set every discovery pass where this externalId is still present in the source's listing.
  lastSeenAt   DateTime?
  /// Set every time the detail page itself was actually re-fetched (distinct from lastSeenAt).
  lastCrawledAt DateTime?
  /// Set when the reconciled content actually changed vs. the previous contentHash.
  lastChangedAt DateTime?
  /// Increments each discovery pass this externalId is absent; resets to 0 when seen again.
  consecutiveMissingRuns Int @default(0)
  /// Flips false once consecutiveMissingRuns crosses ingest.missingRunsThreshold.
  active        Boolean   @default(true)
  /// True until a normalized Job has been produced (or aggregation is given up on after validation
  /// failure) — needed because "job IS NULL" can't distinguish "never attempted" from "permanently
  /// invalid" from "transient AI failure, please retry."
  needsAggregation Boolean @default(true)
  /// Claim marker so overlapping cron ticks don't double-pay for the same AI call.
  aggregationClaimedAt DateTime?
  /// Stamped with the extractor/selector logic version that produced this row's payload — lets a
  /// future rewrite force-reprocess old rows by bumping the version.
  extractionVersion String?
  discoveredAt DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ingestRunId  String?
  ingestRun    IngestRun?  @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)

  improvementRuns ImprovementRun[]
  ingestFailures  IngestFailure[]
  job             Job?

  // Idempotent ingestion: re-posting the same (source, externalId) upserts, never duplicates.
  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([fetchStatus])
  @@index([sourceId, active])
  @@index([fetchStatus, needsAggregation])
  @@index([ingestRunId])
}

enum IngestRunStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per source per discovery cycle. status=FAILED means discovery itself could not
/// complete (listing unreachable, robots.txt disallowed) — NOT "some items inside it failed."
/// Per-item failures are tracked via the counters below and IngestFailure rows; a run with
/// failedCount > 0 is still COMPLETED.
model IngestRun {
  id                    String          @id @default(cuid())
  sourceId              String
  source                Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status                IngestRunStatus @default(RUNNING)
  startedAt             DateTime        @default(now())
  finishedAt            DateTime?
  discoveredCount       Int             @default(0)
  newCount              Int             @default(0)
  changedCount          Int             @default(0)
  unchangedCount        Int             @default(0)
  missingCount          Int             @default(0)
  inactiveCount         Int             @default(0)
  failedCount           Int             @default(0)
  validationFailedCount Int             @default(0)
  aiFailedCount         Int             @default(0)
  /// Durable activity shown in admin after refresh/navigation; cleared when a run finishes.
  currentStage          String?
  currentJobTitle       String?
  heartbeatAt           DateTime?

  rawJobs  RawJob[]
  failures IngestFailure[]

  @@index([sourceId, startedAt])
  @@index([status])
}

enum IngestFailureStage {
  DISCOVERY
  ACQUISITION
  EXTRACTION
  AGGREGATION
  VALIDATION
  PERSISTENCE
  SEO_REWRITE
}

enum IngestFailureStatus {
  OPEN
  RETRYING
  RESOLVED
  DISMISSED
}

/// Human-readable per-URL error detail — nothing else in the schema captures more than a bare
/// enum status, and "failed extractions can be inspected" needs an actual message/detail payload.
model IngestFailure {
  id          String             @id @default(cuid())
  ingestRunId String
  ingestRun   IngestRun          @relation(fields: [ingestRunId], references: [id], onDelete: Cascade)
  rawJobId    String?
  rawJob      RawJob?            @relation(fields: [rawJobId], references: [id], onDelete: SetNull)
  stage       IngestFailureStage
  url         String?
  message     String
  detail      Json?
  status      IngestFailureStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([ingestRunId])
  @@index([rawJobId])
  @@index([stage])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Stage 2: Improving
// ---------------------------------------------------------------------------

enum ImprovementStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ImprovementRun {
  id            String            @id @default(cuid())
  rawJobId      String
  rawJob        RawJob            @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?              @relation(fields: [jobId], references: [id])
  model         String
  promptVersion String
  inputTokens   Int?
  outputTokens  Int?
  /// Rewrite diff or before/after snapshot, shape owned by phase 2.
  diff          Json?
  status        ImprovementStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([rawJobId])
  @@index([jobId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3: Posting (Phase 1 — this is what the public UI reads)
// ---------------------------------------------------------------------------

enum JobStatus {
  DISCOVERED
  IMPROVING
  READY
  PUBLISHED
  CLOSED
  ARCHIVED
  REJECTED
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// What kind of opportunity a Job row represents. All share the Job shape (title, org, location,
/// deadline, apply link) — this is a tag, not a different schema. Extend by adding a case here AND
/// to `src/config/categories.ts` (single source of truth the nav/filters/ingest all read from).
enum OpportunityCategory {
  JOB
  INTERNSHIP
  LEARNERSHIP
  APPRENTICESHIP
  GRADUATE_PROGRAMME
  CALL_FOR_APPLICATIONS
  FUNDING
}

enum JobIndustry {
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  ENGINEERING
  EDUCATION
  GOVERNMENT
  RETAIL
  CONSTRUCTION_PROPERTY
  MANUFACTURING
  TRANSPORT_LOGISTICS
  HOSPITALITY_TOURISM
  AGRICULTURE
  MEDIA_MARKETING
  LEGAL
  ENERGY_MINING
  SECURITY
  OTHER
}

enum SouthAfricanProvince {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
  NATIONWIDE
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([name])
}

model Job {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  category       OpportunityCategory @default(JOB)
  industry       JobIndustry @default(OTHER)
  location       String
  province       SouthAfricanProvince @default(NATIONWIDE)
  remoteType     RemoteType
  employmentType EmploymentType
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?        @default("ZAR")
  salaryPeriod   SalaryPeriod?
  /// Rewritten, brand-voice, post-ready description (phase 2 output).
  description    String
  /// Applicant-first interpretation and source-grounded facts shown before the full advert.
  applicationSummary String?
  essentialRequirements String[] @default([])
  preferredRequirements String[] @default([])
  requiredQualifications String[] @default([])
  requiredExperience String[] @default([])
  documentsToPrepare String[] @default([])
  licenceRequirements String[] @default([])
  applicationMethod String?
  referenceNumber String?
  /// JobGigsNow estimate; 0/null means no estimate is available.
  estimatedApplicationMinutes Int?
  applicationGuidanceGeneratedAt DateTime?
  /// Last admin instruction used for the optional AI rewrite on the review screen.
  rewritePrompt  String?
  /// Optimized 1200x630 image used in link previews and on the public job page.
  socialImageUrl String?
  socialImageAlt String?
  socialImageCredit String?
  socialImageSourceUrl String?
  highlights     String[]       @default([])
  /// External apply URL — set unless isNative is true.
  applyUrl       String?
  isNative       Boolean        @default(false)
  status         JobStatus      @default(DISCOVERED)
  postedAt       DateTime?
  /// When JobGigsNow first published the page. `postedAt` remains the source's official date.
  publishedAt    DateTime?
  closesAt       DateTime?
  indexingNotifiedAt DateTime?
  indexingRemovedAt  DateTime?
  rawJobId       String?        @unique
  rawJob         RawJob?        @relation(fields: [rawJobId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tags            JobTag[]
  savedBy         SavedJob[]
  improvementRuns ImprovementRun[]
  guidanceBackfillItems ApplicationGuidanceBackfillItem[]

  // The list query's primary access pattern: published jobs newest first.
  @@index([status, postedAt])
  @@index([status, category, postedAt])
  @@index([status, industry, postedAt])
  @@index([status, province, postedAt])
  @@index([publishedAt])
  @@index([companyId])
  @@index([location])
  // Upgraded to a pg_trgm GIN index on title/description in the initial migration
  // (see prisma/migrations/*/migration.sql) — plain btree here documents intent.
  @@index([title])
}

enum ApplicationGuidanceBackfillStatus {
  RUNNING
  COMPLETED
}

enum ApplicationGuidanceBackfillItemStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Temporary, admin-triggered rollout tracking for application guidance on legacy jobs.
model ApplicationGuidanceBackfillRun {
  id              String                              @id @default(cuid())
  status          ApplicationGuidanceBackfillStatus   @default(RUNNING)
  total           Int
  completed       Int                                 @default(0)
  failed          Int                                 @default(0)
  currentJobTitle String?
  startedAt       DateTime                            @default(now())
  finishedAt      DateTime?
  updatedAt       DateTime                            @updatedAt

  items ApplicationGuidanceBackfillItem[]

  @@index([status, startedAt])
}

model ApplicationGuidanceBackfillItem {
  id        String                                @id @default(cuid())
  runId     String
  run       ApplicationGuidanceBackfillRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job                                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ApplicationGuidanceBackfillItemStatus @default(PENDING)
  error     String?
  claimedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime                              @default(now())
  updatedAt DateTime                              @updatedAt

  @@unique([runId, jobId])
  @@index([runId, status])
  @@index([status, claimedAt])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  jobs JobTag[]
}

model JobTag {
  jobId String
  tagId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Content — genuinely different shape from an opportunity: no deadline, no apply link.
// ---------------------------------------------------------------------------

/// Extend by adding a case here AND to `src/config/categories.ts`.
enum ContentCategory {
  HOW_TO
  CAREER_DEVELOPMENT
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  category    ContentCategory
  summary     String?
  body        String
  author      String?
  source      String?
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, publishedAt])
  @@index([published])
}

model Course {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  provider      String
  description   String
  /// Display string ("Free", "R1,200", "$49") — deliberately not a typed amount; providers quote
  /// price in wildly inconsistent shapes and this is display-only, never filtered/summed.
  priceLabel    String?
  durationLabel String?
  enrollUrl     String
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// Admin-configurable settings — a singleton row (id is always "singleton"), not a generic
// key-value table: there's exactly one setting today (seoRewritePrompt), and a KV table would be
// unused flexibility until a second setting actually shows up.
// ---------------------------------------------------------------------------

model AdminSetting {
  id               String   @id @default("singleton")
  /// Template used by the automatic post-aggregation SEO rewrite stage (src/lib/ingest/seo-rewrite.ts).
  /// Supports {{title}}/{{company}}/{{location}}/{{remoteType}}/{{employmentType}}/{{description}}/{{tags}}/{{applyUrl}}
  /// placeholders. Falls back to DEFAULT_SEO_REWRITE_PROMPT (src/lib/ingest/settings.ts) if no row exists.
  seoRewritePrompt String
  agentEnabled      Boolean @default(true)
  dailyViewGoal     Int     @default(300)
  dailyPublishMin   Int     @default(5)
  dailyPublishMax   Int     @default(10)
  categoryMinimum   Int     @default(5)
  updatedAt        DateTime @updatedAt
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model DailyAgentRun {
  id            String         @id @default(cuid())
  runKey        String         @unique
  dateKey       String
  workflowRunId String?
  status        AgentRunStatus @default(RUNNING)
  currentStage  String?
  summary       Json?
  error         String?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  updatedAt     DateTime       @updatedAt

  @@index([dateKey, startedAt])
  @@index([status])
}

model DailySiteMetric {
  dateKey          String   @id
  measuredDate     String?
  pageViews        Int?
  activeUsers      Int?
  engagedSessions  Int?
  searchClicks     Float?
  searchImpressions Float?
  searchCtr        Float?
  searchPosition   Float?
  applyClicks      Int?
  savedJobs        Int      @default(0)
  publishedJobs    Int      @default(0)
  categoryCounts   Json
  industryCounts   Json @default("{}")
  provinceCounts   Json @default("{}")
  topPages         Json?
  sourceScores     Json?
  speed            Json?
  integrations     Json
  collectedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum AgentInsightKind {
  TRAFFIC
  CATEGORY
  SOURCE
  CONTENT
  SPEED
  SYSTEM
}

enum AgentInsightStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

model AgentInsight {
  id          String             @id @default(cuid())
  fingerprint String             @unique
  kind        AgentInsightKind
  status      AgentInsightStatus @default(ACTIVE)
  title       String
  detail      String
  action      String?
  evidence    Json?
  confidence  Float              @default(0)
  firstSeenAt DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  resolvedAt  DateTime?

  @@index([status, lastSeenAt])
  @@index([kind, lastSeenAt])
}

enum AgentExperimentStatus {
  PROPOSED
  RUNNING
  KEPT
  REVERTED
  CANCELLED
}

model AgentExperiment {
  id          String                @id @default(cuid())
  hypothesis  String
  metric      String
  change      String
  status      AgentExperimentStatus @default(PROPOSED)
  baseline    Json?
  result      Json?
  decision    String?
  startedAt   DateTime?
  endsAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// User data (Clerk-keyed, no local User table)
// ---------------------------------------------------------------------------

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Serialized filter state: { q, industry, province, remote, employmentType, salaryMin, tags, company, postedWithin }
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts JobAlert[]

  @@index([userId])
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

model JobAlert {
  id            String         @id @default(cuid())
  userId        String
  savedSearchId String?
  savedSearch   SavedSearch?   @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  frequency     AlertFrequency @default(DAILY)
  enabled       Boolean        @default(true)
  lastSentAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}
