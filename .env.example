# PostgreSQL connection string. In dev, `npx prisma dev` spins up a local Postgres and prints one.
DATABASE_URL="postgresql://user:password@localhost:5432/hirelane?sslmode=disable"

# Public base URL of this app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From a Clerk project dashboard (clerk.com) — used only for saved jobs, saved searches and alerts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Bearer token phase-2 ingestion workers send as `Authorization: Bearer <token>`. Generate with
# `openssl rand -hex 24`.
INGEST_SERVICE_TOKEN="replace-with-a-long-random-secret"

# Feature flags — "true" or "false".
FEATURE_NATIVE_APPLY="false"
FEATURE_ALERTS="true"
