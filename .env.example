# PostgreSQL connection string. In dev, `npx prisma dev` spins up a local Postgres and prints one.
DATABASE_URL="postgresql://user:password@localhost:5432/jobgigsnow?sslmode=disable"

# Public base URL of this app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From a Clerk project dashboard (clerk.com) — used only for saved jobs, saved searches and alerts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Bearer token phase-2 ingestion workers send as `Authorization: Bearer <token>`. Generate with
# `openssl rand -hex 24`.
INGEST_SERVICE_TOKEN="replace-with-a-long-random-secret"

# Secret Vercel Cron sends as `Authorization: Bearer <token>` on every scheduled invocation of
# /api/cron/tick. Generate with `openssl rand -hex 24` and set the same value in the Vercel
# project's env vars — Vercel reads CRON_SECRET automatically, no extra config needed.
CRON_SECRET="replace-with-a-long-random-secret"

# AI aggregation stage (src/lib/ingest/aggregate.ts) — reconciles a raw extraction bundle into one
# normalized job record. AI_PROVIDER picks which adapter is used; only that provider's API key is
# required.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-4-5"
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# Feature flags — "true" or "false".
FEATURE_NATIVE_APPLY="false"
FEATURE_ALERTS="true"
